{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.19.0/.schema/devbox.schema.json",
  "packages": {
    "rustup": "1.29.3",
    "just": "1.59.0",
    "pre-commit": "4.7.0",
    "gcc": "16.2.0",
    "gnumake": "4.4.1",
    "pkg-config": "0.29.2",
    "path:./packaging/devbox/native#libclang": {
      "outputs": ["out"]
    },
    "libcap_ng": {
      "version": "0.9.6",
      "outputs": ["out", "dev"]
    },
    "path:./packaging/devbox/native#openssl": {
      "outputs": ["out", "dev"]
    },
    "elfutils": {
      "version": "0.195",
      "outputs": ["out", "dev"]
    },
    "flex": "2.6.4",
    "bison": "3.8.2",
    "bc": "1.08.2",
    "path:./packaging/devbox/native#python": {},
    "patch": "2.8",
    "xz": "5.8.4",
    "perl": "5.42.3",
    "git": "2.56.0",
    "go": "1.27.3",
    "ruby": "4.0.9"
  },
  "env": {
    "RUSTUP_HOME": "$DEVBOX_PROJECT_ROOT/.devbox/rustup",
    "CARGO_HOME": "$DEVBOX_PROJECT_ROOT/.devbox/cargo",
    "RUST_TOOLCHAIN_VERSION": "1.99.1",
    "LIBCLANG_PATH": "$DEVBOX_PROJECT_ROOT/.devbox/nix/profile/default/lib",
    "BINDGEN_EXTRA_CLANG_ARGS": "-resource-dir=\"$DEVBOX_PROJECT_ROOT/.devbox/nix/profile/default/lib/clang/23\"",
    "PATH": "$DEVBOX_PROJECT_ROOT/.devbox/cargo/bin:$PATH"
  },
  "shell": {
    "init_hook": [
      "rustup toolchain list | grep -q \"^$RUST_TOOLCHAIN_VERSION-\" || rustup toolchain install \"$RUST_TOOLCHAIN_VERSION\" --profile minimal --component clippy --component rustfmt",
      "rustup default \"$RUST_TOOLCHAIN_VERSION\" >/dev/null"
    ]
  }
}
